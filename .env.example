# Copy to .env.local and fill in real values. Never commit filled-in env files.

# --- Supabase (required for real accounts) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for privileged auth operations and as a demo-token key fallback.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (required for AI features) ---
GEMINI_API_KEY=

# --- Application secrets ---
# Signs demo session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Required to trigger /api/labor-rights?sync=1 (sent as x-admin-secret)
ADMIN_SECRET=
