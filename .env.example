# Copy to .env.local and fill in real values. Never commit filled-in env files.

# --- Supabase (required for real accounts) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for privileged auth operations and as a demo-token key fallback.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (required for AI features) ---
GEMINI_API_KEY=

# --- Application secrets ---
# Signs demo session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Required to trigger /api/labor-rights?sync=1 (sent as x-admin-secret)
ADMIN_SECRET=

# --- Optional: distributed rate limiting (Upstash Redis REST) ---
# When both are set, limits are shared across all serverless instances.
# Falls back to in-memory limiting when unset or unreachable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: log shipping to Elasticsearch / Kibana ---
# Paste the Elastic Cloud endpoint (no trailing slash) and the encoded API key.
# Logs are POSTed to <url>/<index>-YYYY.MM.DD/_doc after the response is sent.
ELASTIC_LOGS_URL=
ELASTIC_LOGS_API_KEY=
ELASTIC_LOGS_INDEX=muwazaf-logs
